<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 用户信息头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:background="@drawable/bg_header_gradient">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp">

                <View
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="28sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="张三"
                    android:textColor="@color/on_yellow"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="138****1111"
                    android:textColor="@color/on_yellow_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 功能入口卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/entry_address"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:text="📍　地址管理"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/entry_coupon"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:text="🎟️　优惠券"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/entry_review"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:text="⭐　我的评价"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_logout"
            style="@style/CardButtonLight"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="16dp"
            android:text="退出登录" />
    </LinearLayout>
</ScrollView>
